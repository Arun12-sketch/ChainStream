# ChainStream Environment Configuration

# Service Ports
PORT=8080
METRICS_PORT=9090
PROCESSOR_METRICS_PORT=9091
DASHBOARD_PORT=3000

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/chainstream?sslmode=disable

# Redis Cluster / Instance
REDIS_URL=redis://localhost:6379

# Apache Kafka Brokers
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=chainstream-processors

# EVM RPC Endpoints (Testnets)
ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
ETH_SEPOLIA_WS=wss://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_WS=wss://base-sepolia-rpc.publicnode.com
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_AMOY_WS=wss://polygon-amoy-bor-rpc.publicnode.com

# Ingestion Settings
ENABLE_RPC_SIMULATION=false
WORKER_ID=worker-local-01

# Next.js Dashboard Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
