      "title": "Blocks Indexed per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(chainstream_blocks_indexed_total[1m])",
          "legendFormat": "Chain {{chain_id}}"
        }
      ]
    },
    {
      "title": "Decoded Events Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(chainstream_events_decoded_total[1m])",
          "legendFormat": "Chain {{chain_id}}"
        }
      ]
    },
    {
      "title": "Indexing Lag Behind Chain Head (Blocks)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "chainstream_lag_blocks",
          "legendFormat": "Chain {{chain_id}}"
        }
      ]
    },
    {
      "title": "Detected Chain Reorganizations",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
