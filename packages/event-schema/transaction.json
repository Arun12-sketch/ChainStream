{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransactionMessage",
  "type": "object",
  "properties": {
    "version": { "type": "string", "enum": ["v1"] },
    "chain_id": { "type": "integer" },
    "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "block_number": { "type": "integer" },
    "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "tx_index": { "type": "integer" },
    "from_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "to_address": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value": { "type": "string" },
    "gas_price": { "type": "string" },
    "gas_used": { "type": "string" },
    "status": { "type": "integer" },
    "input_data": { "type": "string" },
    "is_canonical": { "type": "boolean" }
  },
  "required": ["version", "chain_id", "tx_hash", "block_number", "block_hash", "tx_index", "from_address", "is_canonical"]
}
