{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventLogMessage",
  "type": "object",
  "properties": {
    "version": { "type": "string", "enum": ["v1"] },
    "chain_id": { "type": "integer" },
    "log_index": { "type": "integer" },
    "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "block_number": { "type": "integer" },
    "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "contract_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "event_name": { "type": ["string", "null"] },
    "event_signature": { "type": ["string", "null"] },
    "topic0": { "type": ["string", "null"] },
    "topic1": { "type": ["string", "null"] },
    "topic2": { "type": ["string", "null"] },
    "topic3": { "type": ["string", "null"] },
    "raw_data": { "type": "string" },
    "decoded_params": { "type": ["object", "null"] },
    "is_canonical": { "type": "boolean" }
  },
  "required": ["version", "chain_id", "log_index", "tx_hash", "block_number", "block_hash", "contract_address", "is_canonical"]
}
